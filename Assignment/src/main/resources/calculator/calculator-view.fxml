<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="calculator.CalculatorController"
      prefWidth="360" prefHeight="480" spacing="16"
      styleClass="calculator" stylesheets="@calculator.css">
    <TextField fx:id="display" text="0" editable="false" focusTraversable="false"
               alignment="CENTER_RIGHT" prefHeight="88" minHeight="88"
               styleClass="display" accessibleText="Calculator display"/>
    <GridPane hgap="10" vgap="10" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
        </rowConstraints>
        <Button fx:id="clearButton" text="Clear" onAction="#handleClear"
                styleClass="calculator-button, clear-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
        <Button fx:id="divideButton" text="÷" userData="DIVIDE" onAction="#handleOperation"
                accessibleText="Divide" styleClass="calculator-button, operation-button"
                maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Button fx:id="digit7Button" text="7" userData="7" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Button fx:id="digit8Button" text="8" userData="8" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button fx:id="digit9Button" text="9" userData="9" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Button fx:id="multiplyButton" text="×" userData="MULTIPLY" onAction="#handleOperation"
                accessibleText="Multiply" styleClass="calculator-button, operation-button"
                maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        <Button fx:id="digit4Button" text="4" userData="4" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Button fx:id="digit5Button" text="5" userData="5" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button fx:id="digit6Button" text="6" userData="6" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Button fx:id="subtractButton" text="−" userData="SUBTRACT" onAction="#handleOperation"
                accessibleText="Subtract" styleClass="calculator-button, operation-button"
                maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
        <Button fx:id="digit1Button" text="1" userData="1" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Button fx:id="digit2Button" text="2" userData="2" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button fx:id="digit3Button" text="3" userData="3" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <Button fx:id="addButton" text="+" userData="ADD" onAction="#handleOperation"
                accessibleText="Add" styleClass="calculator-button, operation-button"
                maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
        <Button fx:id="digit0Button" text="0" userData="0" onAction="#handleDigit"
                styleClass="calculator-button, number-button" maxWidth="Infinity" maxHeight="Infinity"
                GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Button fx:id="decimalButton" text="." onAction="#handleDecimal"
                accessibleText="Decimal point" styleClass="calculator-button, number-button"
                maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Button fx:id="equalsButton" text="=" onAction="#handleEquals"
                accessibleText="Equals" styleClass="calculator-button, operation-button"
                maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="2"
                GridPane.columnSpan="2"/>
    </GridPane>
</VBox>
